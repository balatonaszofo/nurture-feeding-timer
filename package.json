{
  "name": "nurture-daily",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "native:bundle": "node scripts/build-native-bridge.mjs",
    "native:prepare": "node scripts/prepare-native.mjs",
    "native:sync": "npm run native:prepare && cap sync android",
    "native:open": "npm run native:sync && cap open android",
    "native:build": "npm run native:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  }
}
