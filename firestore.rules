rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function ownsProfile() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validProfileDocument() {
        return request.resource.data.keys().hasOnly(['state', 'schemaVersion', 'updatedAt'])
          && request.resource.data.state is map
          && request.resource.data.schemaVersion == 1
          && request.resource.data.updatedAt is timestamp;
      }

      allow read: if ownsProfile();
      allow create, update: if ownsProfile() && validProfileDocument();
      allow delete: if false;

      // Content planning is separate from the care profile document.
      match /contentBoard/{boardId} {
        allow read: if ownsProfile() && boardId == 'state';
        allow create, update: if ownsProfile() && boardId == 'state'
          && request.resource.data.keys().hasOnly(['projects', 'changes', 'schemaVersion', 'updatedAt'])
          && request.resource.data.projects is list
          && request.resource.data.projects.size() <= 100
          && request.resource.data.changes is list
          && request.resource.data.changes.size() <= 100
          && request.resource.data.schemaVersion == 1
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
